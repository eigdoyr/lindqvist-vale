---
import Logo from './Logo.astro';
---

<div class="intro-curtain" id="intro-flash" aria-hidden="true">
  <div class="logo-wrapper">
    <Logo />
  </div>
</div>

<script>
  // Module scope survives client-side navigation; the DOM does not.
  let hasNavigated = false;

  document.addEventListener('astro:after-swap', () => {
    hasNavigated = true;
    document.getElementById('intro-flash')?.remove();
  });

  const initIntro = () => {
    const curtain = document.getElementById('intro-flash');
    if (!curtain) return;

    if (hasNavigated) {
      curtain.remove();
      return;
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const release = () => {
      document.body.classList.remove('is-intro-locked');
    };

    document.body.classList.add('is-intro-locked');
    curtain.addEventListener('animationend', release, { once: true });

    // Fallback: animationend does not fire if the tab is backgrounded.
    setTimeout(release, 2200);
  };

  document.addEventListener('astro:page-load', initIntro);
  if (document.readyState !== 'loading') initIntro();
</script>

<style lang="scss">
  @use '../styles/tokens/variables' as *;

  .intro-curtain {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: #0e0e0e;
    will-change: transform;
    animation: curtainDismiss $duration-page * 1.6 $ease-editorial forwards;

    .logo-wrapper {
      position: absolute;
      top: 50%;
      left: 50%;
      width: min(65vw, 320px);
      color: #ffffff;
      opacity: 0;
      transform: translate(-50%, calc(-50% + 6px)) scale(0.95);
      animation: logoReveal $duration-page * 1.6 $ease-out-editorial forwards;

      :global(svg) {
        width: 100%;
        height: auto;
        display: block;
        fill: currentColor;
      }
    }
  }

  @keyframes curtainDismiss {
    0%,
    42% {
      transform: translateY(0);
      visibility: visible;
    }
    99% {
      transform: translateY(-100%);
      visibility: visible;
    }
    100% {
      transform: translateY(-100%);
      visibility: hidden;
    }
  }

  @keyframes logoReveal {
    0% {
      opacity: 0;
      transform: translate(-50%, calc(-50% + 6px)) scale(0.95);
    }
    16%,
    42% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
    58%,
    100% {
      opacity: 0;
      transform: translate(-50%, calc(-50% - 10px)) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-curtain {
      display: none;
    }
  }
</style>