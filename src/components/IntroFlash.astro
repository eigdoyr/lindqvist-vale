---
import Logo from './Logo.astro';
---

<div class="intro-curtain" id="intro-flash" aria-hidden="true">
  <div class="logo-wrapper">
    <Logo />
  </div>
</div>

<script>
  const initIntro = () => {
    const curtain = document.getElementById('intro-flash');
    if (!curtain) return;

    // Respect reduced motion settings
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      curtain.style.display = 'none';
      document.body.style.overflow = '';
      return;
    }

    document.body.style.overflow = 'hidden';

    // Dismiss curtain after hold
    const dismissTimer = setTimeout(() => {
      curtain.classList.add('is-dismissed');
      document.body.style.overflow = '';
    }, 800);

    // Hard safety timeout in case transitionend fails
    const safetyTimer = setTimeout(() => {
      curtain.style.display = 'none';
      document.body.style.overflow = '';
    }, 2200);

    curtain.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'transform') {
        clearTimeout(safetyTimer);
        curtain.style.display = 'none';
      }
    });
  };

  // Supports standard load and Astro Client Router navigation
  document.addEventListener('astro:page-load', initIntro);
  if (document.readyState !== 'loading') initIntro();
</script>

<style lang="scss">
  @use '../styles/tokens/variables' as *;

  .intro-curtain {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: #0e0e0e;
    transition: transform 1.1s cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;

    .logo-wrapper {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: min(65vw, 320px);
      color: #ffffff;
      opacity: 0;
      animation: logoReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      transition: opacity 0.3s ease, transform 0.3s ease;

      :global(svg) {
        width: 100%;
        height: auto;
        display: block;
        fill: currentColor;
      }
    }

    &.is-dismissed {
      transform: translateY(-100%);

      .logo-wrapper {
        opacity: 0 !important;
        transform: translate(-50%, calc(-50% - 10px));
      }
    }
  }

  @keyframes logoReveal {
    0% {
      opacity: 0;
      transform: translate(-50%, calc(-50% + 6px)) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }
</style>