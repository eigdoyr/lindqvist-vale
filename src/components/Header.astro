---
import { NAV_LINKS } from '../data/navigation';
import Logo from './Logo.astro';
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <button class="nav-trigger type-caption" id="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">
      <span class="label-menu">MENU</span>
      <span class="label-close">CLOSE</span>
    </button>

    <a href="/" class="brand-logo" aria-label="Home">
      <Logo />
    </a>

    <a href="#contact" class="contact-link type-caption">
      CONTACT
    </a>
  </div>

  <nav class="mobile-overlay" id="mobile-nav" aria-hidden="true">
    <ul class="nav-list">
      {NAV_LINKS.map((link) => (
        <li>
          <a href={link.href} class="nav-link type-heading-l">{link.label}</a>
        </li>
      ))}
    </ul>
    <div class="drawer-footer type-caption">
      <span>ZÜRICH / NEW YORK / TOKYO</span>
      <span>© 2026 LINDQVIST & VALE</span>
    </div>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const header = document.getElementById('site-header');
  const mobileNav = document.getElementById('mobile-nav');

  if (toggleBtn && header && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = header.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      mobileNav.setAttribute('aria-hidden', String(!isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        header.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileNav.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
  }
</script>

<style lang="scss">
  @use '../styles/tokens/variables' as *;

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    mix-blend-mode: difference;
    color: #FFFFFF;

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: clamp(1rem, 2vw, 1.75rem) $space-fluid-page;
      position: relative;
      z-index: 1001;
    }

    .nav-trigger, .brand-logo, .contact-link {
      color: inherit;
      text-decoration: none;
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      padding: 0;

      &:hover {
        opacity: 0.7;
      }
    }

    .nav-trigger {
      .label-close {
        display: none;
      }
    }

    /* MOBILE DRAWER OVERLAY */
    .mobile-overlay {
      position: fixed;
      inset: 0;
      background-color: $color-bg;
      color: $color-text;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: clamp(6rem, 12vh, 8rem) $space-fluid-page $space-fluid-page;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s;
      z-index: 1000;

      .nav-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 3vh, 2.5rem);

        .nav-link {
          color: inherit;
          text-decoration: none;
          transition: transform 0.3s;
          display: inline-block;

          &:hover {
            transform: translateX(10px);
          }
        }
      }

      .drawer-footer {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid rgba($color-text, 0.15);
        padding-top: 1.5rem;
        color: $color-muted;
      }
    }

    /* OPEN STATE OVERRIDES */
    &.is-open {
      mix-blend-mode: normal;

      .header-inner {
        color: $color-text;
      }

      .nav-trigger {
        .label-menu { display: none; }
        .label-close { display: inline; }
      }

      .mobile-overlay {
        opacity: 1;
        pointer-events: auto;
      }
    }
  }

  @media (max-width: 600px) {
    .site-header .mobile-overlay .drawer-footer {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>