---
import { NAV_LINKS } from '../data/navigation';
import Logo from './Logo.astro';
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <button class="nav-trigger type-caption" id="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">
      <span class="label-menu">MENU</span>
      <span class="label-close">CLOSE</span>
    </button>

    <a href="/" class="brand-logo" aria-label="LINDQVIST & VALE Home">
      <Logo />
    </a>

    <a href="#contact" class="contact-link type-caption">
      CONTACT
    </a>
  </div>

  <!-- Mobile/Tablet Navigation Drawer -->
  <nav class="mobile-overlay" id="mobile-nav" aria-hidden="true">
    <ul class="nav-list">
      {NAV_LINKS.map((link) => (
        <li>
          <a href={link.href} class="nav-link type-heading-l">{link.label}</a>
        </li>
      ))}
    </ul>
    <div class="drawer-footer type-caption">
      <span>ZÜRICH / NEW YORK / TOKYO</span>
      <span>© 2026 LINDQVIST & VALE</span>
    </div>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const header = document.getElementById('site-header');
  const mobileNav = document.getElementById('mobile-nav');

  // Menu Drawer Toggle Logic
  if (toggleBtn && header && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = header.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      mobileNav.setAttribute('aria-hidden', String(!isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        header.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileNav.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
  }

  // 100vh Hero Scroll Detection
  const handleScroll = () => {
    if (!header) return;
    const threshold = window.innerHeight - 80;
    if (window.scrollY >= threshold) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>

<style lang="scss">
  @use '../styles/tokens/variables' as *;

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    /* Initial scrim gradient over dark hero */
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 100%);
    transition: background 0.4s $ease-editorial, 
                border-color 0.4s $ease-editorial,
                color 0.4s $ease-editorial;

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: clamp(1.25rem, 2.5vw, 2rem) $space-fluid-page;
      position: relative;
      z-index: 1001;
      color: #FFFFFF;
      transition: color 0.4s $ease-editorial;
    }

    .brand-logo {
      width: clamp(140px, 12vw, 180px);

      :global(svg) {
        width: 100%;
        height: auto;
        display: block;
        fill: currentColor;
        color: inherit;
      }
    }

    .nav-trigger, .brand-logo, .contact-link {
      color: #FFFFFF;
      text-decoration: none;
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      padding: 0;
      display: inline-flex;
      align-items: center;
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
      transition: opacity 0.2s ease, color 0.4s $ease-editorial, filter 0.4s $ease-editorial;

      &:hover {
        opacity: 0.75;
      }
    }

    .nav-trigger {
      .label-close {
        display: none;
      }
    }

    /* SCROLLED STATE (PAST 100VH HERO) */
    &.is-scrolled:not(.is-open) {
      background: $color-bg;
      border-bottom: 1px solid rgba($color-text, 0.1);

      .header-inner {
        color: $color-text;
      }

      .nav-trigger, .brand-logo, .contact-link {
        color: $color-text;
        filter: none;
      }
    }

    /* MOBILE DRAWER OVERLAY */
    .mobile-overlay {
      position: fixed;
      inset: 0;
      background-color: $color-bg;
      color: $color-text;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: clamp(6rem, 12vh, 8rem) $space-fluid-page $space-fluid-page;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s $ease-editorial;
      z-index: 1000;

      .nav-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 3vh, 2.5rem);

        .nav-link {
          color: $color-text;
          text-decoration: none;
          transition: transform 0.3s $ease-editorial;
          display: inline-block;

          &:hover {
            transform: translateX(10px);
          }
        }
      }

      .drawer-footer {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid rgba($color-text, 0.15);
        padding-top: 1.5rem;
        color: $color-muted;
      }
    }

    /* OPEN STATE OVERRIDES */
    &.is-open {
      background: transparent;

      .header-inner {
        color: $color-text;
      }

      .nav-trigger, .brand-logo, .contact-link {
        color: $color-text;
        filter: none;
      }

      .nav-trigger {
        .label-menu { display: none; }
        .label-close { display: inline; }
      }

      .mobile-overlay {
        opacity: 1;
        pointer-events: auto;
      }
    }
  }

  @media (max-width: 600px) {
    .site-header .mobile-overlay .drawer-footer {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>