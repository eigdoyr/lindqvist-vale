---
import { NAV_LINKS } from '../data/navigation';
import Logo from './Logo.astro';

interface Props {
  isInnerPage?: boolean;
  theme?: 'dark' | 'light';
}

const { isInnerPage = false, theme = 'dark' } = Astro.props;
const isLightState = isInnerPage || theme === 'light';
---

<header 
  class:list={[
    'site-header',
    { 'is-inner-page': isLightState, 'is-scrolled': isLightState }
  ]} 
  id="site-header"
  data-inner-page={isLightState ? 'true' : 'false'}
>
  <div class="header-inner">
    <button class="nav-trigger type-caption" id="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">
      <span class="label-menu">Menu</span>
      <span class="label-close">Close</span>
    </button>

    <a href="/" class="brand-logo" aria-label="LINDQVIST & VALE Home">
      <Logo />
    </a>

    <a href="#contact" class="contact-link type-caption">Contact</a>
  </div>

  <nav class="mobile-overlay" id="mobile-nav" aria-hidden="true">
    <ul class="nav-list">
      {NAV_LINKS.map((link) => (
        <li>
          <a href={link.href} class="nav-link type-heading-l">{link.label}</a>
        </li>
      ))}
    </ul>
    <div class="drawer-footer type-caption">
      <span>Zürich / New York / Tokyo</span>
      <span>© 2026 LINDQVIST & VALE</span>
    </div>
  </nav>
</header>

<script>
  const setupHeader = () => {
    const toggleBtn = document.getElementById('menu-toggle');
    const header = document.getElementById('site-header');
    const mobileNav = document.getElementById('mobile-nav');

    if (!header || !toggleBtn || !mobileNav) return;

    const isInnerPage = header.dataset.innerPage === 'true';

    // Menu Drawer Toggle
    const toggleMenu = (open?: boolean) => {
      const isOpen = open !== undefined ? open : header.classList.toggle('is-open');
      if (open === false) header.classList.remove('is-open');

      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      mobileNav.setAttribute('aria-hidden', String(!isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    };

    toggleBtn.addEventListener('click', () => toggleMenu());

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => toggleMenu(false));
    });

    // Close on Escape Key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        toggleMenu(false);
      }
    });

    // Scroll Listener
    let ticking = false;
    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          if (isInnerPage) {
            // Inner pages / Light theme locked to solid header state
            header.classList.add('is-scrolled');
          } else {
            // Home page: 100vh hero threshold switch
            const threshold = window.innerHeight - 80;
            if (window.scrollY >= threshold) {
              header.classList.add('is-scrolled');
            } else {
              header.classList.remove('is-scrolled');
            }
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  };

  document.addEventListener('astro:page-load', setupHeader);
  if (document.readyState !== 'loading') setupHeader();
</script>

<style lang="scss">
  @use '../styles/tokens/variables' as *;

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 100%);
    transition: background 0.4s $ease-editorial, 
                border-color 0.4s $ease-editorial,
                color 0.4s $ease-editorial;

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: clamp(1.25rem, 2.5vw, 2rem) $space-fluid-page;
      position: relative;
      z-index: 1001;
      color: #ffffff;
      transition: color 0.4s $ease-editorial;
    }

    .brand-logo {
      width: clamp(140px, 12vw, 180px);

      :global(svg) {
        width: 100%;
        height: auto;
        display: block;
        fill: currentColor;
      }
    }

    .nav-trigger, .brand-logo, .contact-link {
      color: #ffffff;
      text-decoration: none;
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      padding: 0;
      display: inline-flex;
      align-items: center;
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
      transition: opacity 0.2s ease, color 0.4s $ease-editorial, filter 0.4s $ease-editorial;

      &:hover {
        opacity: 0.75;
      }
    }

    .nav-trigger .label-close { display: none; }

    /* LIGHT / SCROLLED STATE (Immediate on inner pages, past hero on home) */
    &.is-scrolled:not(.is-open),
    &.is-inner-page:not(.is-open) {
      background: $color-bg;
      border-bottom: 1px solid rgba($color-text, 0.15);

      .header-inner { color: $color-text; }
      .nav-trigger, .brand-logo, .contact-link {
        color: $color-text;
        filter: none;
      }
    }

    /* MOBILE OVERLAY */
    .mobile-overlay {
      position: fixed;
      inset: 0;
      background-color: $color-bg;
      color: $color-text;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: clamp(6rem, 12vh, 8rem) $space-fluid-page $space-fluid-page;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s $ease-editorial;
      z-index: 1000;

      .nav-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 3vh, 2.5rem);

        .nav-link {
          color: $color-text;
          text-decoration: none;
          transition: transform 0.3s $ease-editorial;

          &:hover { transform: translateX(10px); }
        }
      }

      .drawer-footer {
        display: flex;
        justify-content: space-between;
        padding-top: 1.5rem;
        color: $color-muted;
      }
    }

    &.is-open {
      background: transparent;

      .header-inner { color: $color-text; }
      .nav-trigger, .brand-logo, .contact-link {
        color: $color-text;
        filter: none;
      }

      .nav-trigger {
        .label-menu { display: none; }
        .label-close { display: inline; }
      }

      .mobile-overlay {
        opacity: 1;
        pointer-events: auto;
      }
    }
  }
</style>