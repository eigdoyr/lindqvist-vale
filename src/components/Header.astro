---
import { NAV_LINKS } from '../data/navigation';
import Logo from './Logo.astro';

interface Props {
  isInnerPage?: boolean;
  theme?: 'dark' | 'light';
}

const { isInnerPage = false, theme = 'dark' } = Astro.props;
const isLightState = isInnerPage || theme === 'light';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header 
  class:list={[
    'site-header',
    { 'is-inner-page': isLightState, 'is-scrolled': isLightState }
  ]} 
  id="site-header"
  data-inner-page={isLightState ? 'true' : 'false'}
>
  <div class="header-inner">
    <button class="nav-trigger type-caption" id="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">
      <span class="label-menu">Menu</span>
      <span class="label-close">Close</span>
    </button>

    <a href="/" class="brand-logo" aria-label="LINDQVIST & VALE Home">
      <Logo />
    </a>

    <a href="#contact" class="contact-link type-caption">Contact</a>
  </div>

  <nav class="mobile-overlay" id="mobile-nav" aria-label="Main" inert>
    <ul class="nav-list">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-link type-heading-l"
            aria-current={link.href === currentPath ? 'page' : undefined}
          >{link.label}</a>
        </li>
      ))}
    </ul>
    <div class="drawer-footer type-caption">
      <span>Zürich / New York / Tokyo</span>
      <span>© 2026 LINDQVIST & VALE</span>
    </div>
  </nav>
</header>

<script>
  const FOCUSABLE = 'a[href], button:not([disabled])';

  let teardown: AbortController | null = null;

  const setupHeader = () => {
    teardown?.abort();
    teardown = new AbortController();
    const { signal } = teardown;

    const header = document.getElementById('site-header');
    const toggleBtn = document.getElementById('menu-toggle');
    const drawer = document.getElementById('mobile-nav');

    if (!header || !toggleBtn || !drawer) return;

    const isInnerPage = header.dataset.innerPage === 'true';

    const setMenu = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggleBtn.setAttribute('aria-expanded', String(open));
      drawer.toggleAttribute('inert', !open);
      document.body.classList.toggle('is-menu-locked', open);

      if (open) {
        drawer.querySelector<HTMLElement>(FOCUSABLE)?.focus();
      } else {
        toggleBtn.focus();
      }
    };

    toggleBtn.addEventListener(
      'click',
      () => setMenu(!header.classList.contains('is-open')),
      { signal }
    );

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenu(false), { signal });
    });

    document.addEventListener(
      'keydown',
      (e) => {
        if (!header.classList.contains('is-open')) return;

        if (e.key === 'Escape') {
          setMenu(false);
          return;
        }

        if (e.key !== 'Tab') return;

        const items = [...drawer.querySelectorAll<HTMLElement>(FOCUSABLE), toggleBtn];
        const first = items[0];
        const last = items[items.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      },
      { signal }
    );

    let ticking = false;
    const handleScroll = () => {
      if (ticking) return;
      ticking = true;

      window.requestAnimationFrame(() => {
        const solid = isInnerPage || window.scrollY >= window.innerHeight - 80;
        header.classList.toggle('is-scrolled', solid);
        ticking = false;
      });
    };

    window.addEventListener('scroll', handleScroll, { passive: true, signal });
    handleScroll();
  };

  document.addEventListener('astro:page-load', setupHeader);
  if (document.readyState !== 'loading') setupHeader();
</script>

<style lang="scss">
  @use '../styles/tokens/variables' as *;

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 100%);
    transition: background 0.4s $ease-editorial, 
                border-color 0.4s $ease-editorial,
                color 0.4s $ease-editorial;

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: clamp(1.25rem, 2.5vw, 2rem) $space-fluid-page;
      position: relative;
      z-index: 1001;
      color: #ffffff;
      transition: color 0.4s $ease-editorial;
    }

    .brand-logo {
      width: clamp(140px, 12vw, 180px);

      :global(svg) {
        width: 100%;
        height: auto;
        display: block;
        fill: currentColor;
      }
    }

    .nav-trigger, .brand-logo, .contact-link {
      color: #ffffff;
      text-decoration: none;
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      padding: 0;
      display: inline-flex;
      align-items: center;
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
      transition: opacity 0.2s ease, color 0.4s $ease-editorial, filter 0.4s $ease-editorial;

      &:hover {
        opacity: 0.75;
      }
    }

    .nav-trigger .label-close { display: none; }

    &.is-scrolled:not(.is-open),
    &.is-inner-page:not(.is-open) {
      background: $color-bg;
      border-bottom: 1px solid $color-border;

      .header-inner { color: $color-text; }
      .nav-trigger, .brand-logo, .contact-link {
        color: $color-text;
        filter: none;
      }
    }

    .mobile-overlay {
      position: fixed;
      inset: 0;
      background-color: $color-bg;
      color: $color-text;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: clamp(6rem, 12vh, 8rem) $space-fluid-page $space-fluid-page;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.35s $ease-editorial, visibility 0s linear 0.35s;
      z-index: 1000;

      .nav-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 3vh, 2.5rem);

        .nav-link {
          color: $color-muted;
          text-decoration: none;
          transition: transform 0.3s $ease-editorial, color 0.3s $ease-editorial;

          &:hover { transform: translateX(10px); }

          &[aria-current] {
            color: $color-text;
          }
        }
      }

      .drawer-footer {
        display: flex;
        justify-content: space-between;
        padding-top: 1.5rem;
        color: $color-muted;
      }
    }

    &.is-open {
      background: transparent;

      .header-inner { color: $color-text; }
      .nav-trigger, .brand-logo, .contact-link {
        color: $color-text;
        filter: none;
      }

      .nav-trigger {
        .label-menu { display: none; }
        .label-close { display: inline; }
      }

      .mobile-overlay {
        opacity: 1;
        visibility: visible;
        transition: opacity 0.35s $ease-editorial, visibility 0s;
      }
    }
  }
</style>