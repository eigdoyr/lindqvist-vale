---
import type { Project } from '../data/projects';
import { srcset } from '../lib/images';

interface Props {
  project: Project;
  sizes?: string;
}

const { project, sizes = '(max-width: 768px) 85vw, min(56vw, 785px)' } = Astro.props;
---

<article class="project-card reveal">
  <a href={project.href} class="card-link">
    <div class="image-frame">
      <img
        src={project.image}
        srcset={srcset(project.image)}
        sizes={sizes}
        alt={project.alt}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="card-info">
      <h3 class="type-heading-l card-title">{project.title}</h3>
      <div class="metadata type-caption">
        <span>{project.location}</span>
        <span>{project.scale}</span>
        <span>{project.year}</span>
      </div>
    </div>
  </a>
</article>

<style lang="scss">
  @use '../styles/tokens/variables' as *;

  .project-card {
    display: flex;
    flex-direction: column;

    .card-link {
      text-decoration: none;
      color: inherit;
      display: block;
    }

    .image-frame {
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background-color: rgba($color-muted, 0.1);
      margin-bottom: 1.25rem;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform $duration-slow $ease-editorial;
      }

      &:hover img {
        transform: scale(1.02);
      }
    }

    .card-info {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;

      .card-title {
        font-weight: 400;
        font-style: italic;
        transition: opacity $duration-fast $ease-out-editorial;
      }

      .metadata {
        display: flex;
        gap: clamp(1rem, 2.5vw, 2.5rem);
        color: $color-muted;
      }
    }

    &:hover .card-title {
      opacity: 0.65;
    }
  }
</style>