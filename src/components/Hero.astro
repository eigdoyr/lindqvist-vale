---
import { HERO_DATA } from '../data/siteData';
---

<section class="hero-section">
  <div class="hero-media-wrapper">
    <img 
      src={HERO_DATA.bgImage} 
      alt={HERO_DATA.alt} 
      loading="eager"
      decoding="async"
    />
    <div class="media-overlay"></div>
  </div>

  <div class="hero-content">
    <div class="hero-title-group">
      <h1 class="type-heading-xl">{HERO_DATA.title}</h1>
    </div>

    <div class="hero-metadata type-caption">
      <span>{HERO_DATA.location}</span>
      <span>{HERO_DATA.scale}</span>
      <span>{HERO_DATA.year}</span>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens/variables' as *;

  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh; /* Dynamic viewport height for mobile browsers */
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: $space-fluid-page;

    .hero-media-wrapper {
      position: absolute;
      inset: 0;
      z-index: 1;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      .media-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          180deg, 
          rgba(0, 0, 0, 0.25) 0%, 
          rgba(0, 0, 0, 0.1) 40%, 
          rgba(0, 0, 0, 0.45) 100%
        );
      }
    }

    .hero-content {
      position: relative;
      z-index: 2;
      width: 100%;
      color: #FFFFFF;
      display: flex;
      flex-direction: column;
      gap: clamp(1rem, 2vh, 2rem);

      .hero-title-group {
        max-width: 900px;
        
        h1 {
          color: #FFFFFF;
        
        }
      }

      .hero-metadata {
        display: flex;
        flex-wrap: wrap;
        gap: clamp(1rem, 3vw, 3rem);
        color: rgba(#FFFFFF, 0.85);
        border-top: 1px solid rgba(#FFFFFF, 0.25);
        padding-top: 1rem;
      }
    }
  }

  @media (max-width: 600px) {
    .hero-section .hero-content .hero-metadata {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>