---
import SectionHeader from './SectionHeader.astro';
import { ABOUT_DATA } from '../data/about';
import { PROJECTS } from '../data/projects';
import { srcset } from '../lib/images';

const cities = ABOUT_DATA.locations;

const separator = (i: number) => {
  if (i === 0) return '';
  if (i < cities.length - 1) return ', ';
  return cities.length > 2 ? ', and ' : ' and ';
};
---

<section class="about-section" id="about">
  <div class="about-header-wrapper">
    <SectionHeader
      tag={ABOUT_DATA.tag}
      linkText={ABOUT_DATA.linkText}
      linkHref={ABOUT_DATA.linkHref}
    />
  </div>

  <div class="about-content reveal">
    <h2 class="type-heading-xl about-statement">
      {ABOUT_DATA.statementPrefix}
      {cities.map((city, i) => (
        <>{separator(i)}<em>{city}</em></>
      ))}
      {'. '}
      {ABOUT_DATA.statementSuffix}
    </h2>
  </div>

  <div class="about-media-wrapper reveal" id="about-slideshow">
    <div class="slides-container">
      {PROJECTS.map((project, index) => (
        <div class={`slide ${index === 0 ? 'is-active' : ''}`} data-slide={index}>
          <img
            src={project.image}
            srcset={srcset(project.image)}
            sizes="100vw"
            alt={project.alt}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
      <div class="slide-overlay"></div>
    </div>

    <div class="indicator-lines">
      {PROJECTS.map((_, index) => (
        <span class={`line-tick ${index === 0 ? 'is-active' : ''}`} data-tick={index}></span>
      ))}
    </div>
  </div>
</section>

<script>
  let timer: number | undefined;

  const initSlideshow = () => {
    clearInterval(timer);

    const slideshow = document.getElementById('about-slideshow');
    if (!slideshow) return;

    const slides = [...slideshow.querySelectorAll('.slide')];
    const ticks = [...slideshow.querySelectorAll('.line-tick')];

    if (slides.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let current = 0;

    timer = window.setInterval(() => {
      slides[current].classList.remove('is-active');
      ticks[current]?.classList.remove('is-active');

      current = (current + 1) % slides.length;

      slides[current].classList.add('is-active');
      ticks[current]?.classList.add('is-active');
    }, 4500);
  };

  document.addEventListener('astro:page-load', initSlideshow);
  if (document.readyState !== 'loading') initSlideshow();
</script>

<style lang="scss">
  @use '../styles/tokens/variables' as *;

  .about-section {
    padding-top: $space-section-y;
    overflow-x: hidden;

    .about-header-wrapper,
    .about-content {
      padding-inline: $space-fluid-page;
    }

    .about-content {
      max-width: 1200px;
      margin-bottom: clamp(3rem, 6vw, 6rem);

      .about-statement {
        color: $color-text;
        line-height: 1.15;
        font-weight: 400;

        em {
          font-style: italic;
          font-family: $font-lora;
        }
      }
    }

    .about-media-wrapper {
      position: relative;
      width: 100vw;
      margin-left: 50%;
      transform: translateX(-50%);
      aspect-ratio: 21 / 9;
      overflow: hidden;
      background-color: $color-text;

      .slides-container {
        position: relative;
        width: 100%;
        height: 100%;

        .slide {
          position: absolute;
          inset: 0;
          opacity: 0;
          transform: scale(1.04);
          transition: opacity $duration-page $ease-out-editorial, transform $duration-page $ease-out-editorial;
          pointer-events: none;

          &.is-active {
            opacity: 1;
            transform: scale(1);
            pointer-events: auto;
          }

          img {
            width: 100%;
            height: 100%;
            object-fit: cover;
          }
        }

        .slide-overlay {
          position: absolute;
          inset: 0;
          background: linear-gradient(180deg, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.35) 100%);
          pointer-events: none;
        }
      }

      .indicator-lines {
        position: absolute;
        bottom: $space-fluid-page;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 0.5rem;

        .line-tick {
          display: block;
          height: 2px;
          width: 24px;
          background-color: rgba(255, 255, 255, 0.3);
          transition: background-color $duration-base $ease-out-editorial, width $duration-base $ease-editorial;

          &.is-active {
            background-color: #FFFFFF;
            width: 36px;
          }
        }
      }
    }
  }

  @media (max-width: 768px) {
    .about-section {
      .about-media-wrapper {
        aspect-ratio: 16 / 10;

        .indicator-lines .line-tick {
          width: 16px;
          &.is-active {
            width: 24px;
          }
        }
      }
    }
  }
</style>