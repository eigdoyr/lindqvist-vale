---
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '../styles/global.scss';
import '../styles/main.scss';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import IntroFlash from '../components/IntroFlash.astro';

interface Props {
  title?: string;
  description?: string;
  headerTheme?: 'light' | 'dark';
  isInnerPage?: boolean;
}

const {
  title = "LINDQVIST & VALE — Architectural Practice",
  description = "International architectural practice operating between Zürich, New York, and Tokyo." ,
  headerTheme = 'dark',
  isInnerPage = false
} = Astro.props;

const isHome = Astro.url.pathname === '/';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class:list={[{ 'is-inner-page': isInnerPage }]}>
    {isHome && <IntroFlash />}
    <Header theme={headerTheme} isInnerPage={isInnerPage} />
    <slot />

    <script>
      let observer: IntersectionObserver | null = null;

      const setupReveals = () => {
        observer?.disconnect();

        observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer?.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal').forEach((el) => observer?.observe(el));
      };

      document.addEventListener('astro:page-load', setupReveals);
      if (document.readyState !== 'loading') setupReveals();
    </script>
  </body>
</html>