---
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '../styles/global.scss';
import '../styles/main.scss';
import { ClientRouter } from 'astro:transitions';
import { AUTHOR } from '../data/footer';
import Header from '../components/Header.astro';
import IntroFlash from '../components/IntroFlash.astro';

interface Props {
  title?: string;
  description?: string;
  headerTheme?: 'light' | 'dark';
  isInnerPage?: boolean;
}

const {
  title = "LINDQVIST & VALE — Architectural Practice",
  description = "International architectural practice operating between Zürich, New York, and Tokyo." ,
  headerTheme = 'dark',
  isInnerPage = false
} = Astro.props;

const isHome = Astro.url.pathname === '/';

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'LINDQVIST & VALE',
  url: Astro.site?.href ?? canonical,
  description,
  creator: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: AUTHOR.url,
    sameAs: AUTHOR.links.map((link) => link.href),
  },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR.name} />
    <link rel="canonical" href={canonical} />
    <link rel="author" href={AUTHOR.url} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
    <ClientRouter />
  </head>
  <body class:list={[{ 'is-inner-page': isInnerPage }]}>
    {isHome && <IntroFlash />}
    <Header theme={headerTheme} isInnerPage={isInnerPage} />
    <slot />

    <script>
      const STAGGER_STEP = 90;
      const STAGGER_MAX = 5;

      let observer: IntersectionObserver | null = null;

      const setupReveals = () => {
        observer?.disconnect();

        observer = new IntersectionObserver((entries) => {
          // Stagger against what crossed together, not DOM order, so an
          // element scrolled past on its own never waits.
          const arrived = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => {
              const top = a.boundingClientRect.top - b.boundingClientRect.top;
              return top !== 0 ? top : a.boundingClientRect.left - b.boundingClientRect.left;
            });

          arrived.forEach((entry, index) => {
            const target = entry.target as HTMLElement;
            const step = Math.min(index, STAGGER_MAX) * STAGGER_STEP;

            if (step > 0) target.style.setProperty('--reveal-delay', `${step}ms`);
            target.classList.add('is-visible');
            observer?.unobserve(target);
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });

        document.querySelectorAll('.reveal').forEach((el) => observer?.observe(el));
      };

      // after-swap runs before the view transition paints; page-load runs after,
      // which would snapshot the incoming page with everything still hidden.
      document.addEventListener('astro:after-swap', setupReveals);
      if (document.readyState !== 'loading') setupReveals();
    </script>
  </body>
</html>