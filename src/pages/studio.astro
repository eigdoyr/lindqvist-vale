---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { STUDIO_DATA } from '../data/studio';

const s = STUDIO_DATA;
---

<BaseLayout
  title="Studio — LINDQVIST & VALE"
  description="Lindqvist & Vale is an architectural practice operating between Zürich, New York, and Tokyo."
  isInnerPage={true}
>
  <main class="studio">
    <header class="studio-intro" id="studio">
      <div class="intro-copy">
        <span class="type-caption intro-eyebrow">{s.eyebrow}</span>

        <h1 class="type-heading-xl intro-headline reveal">
          {s.headline.map((line) => <span>{line}</span>)}
        </h1>

        <p class="intro-lead type-body-regular">{s.lead}</p>

        <dl class="intro-meta type-caption">
          <div>
            <dt>Coordinates</dt>
            <dd>{s.coordinates}</dd>
          </div>
          <div>
            <dt>Practice</dt>
            <dd>{s.founded}</dd>
          </div>
          <div>
            <dt>Ateliers</dt>
            <dd>Zürich / New York / Tokyo</dd>
          </div>
        </dl>
      </div>

      <figure class="intro-figure reveal">
        <img src={s.image} alt={s.alt} loading="lazy" decoding="async" />
      </figure>
    </header>

    <section class="studio-philosophy site-section" id="philosophy">
      <div class="section-inner">
        <SectionHeader tag="02 / Philosophy" />
        <ol class="pillar-grid">
          {s.pillars.map((pillar) => (
            <li class="pillar reveal">
              <span class="type-caption pillar-ref">{pillar.ref}</span>
              <h2 class="pillar-title">
                {pillar.title.map((line) => <span>{line}</span>)}
              </h2>
              <p class="pillar-body type-body-regular">{pillar.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="studio-parameters site-section" id="parameters">
      <div class="section-inner">
        <SectionHeader tag="03 / Operational parameters" />

        <blockquote class="parameters-quote reveal">
          <p class="type-heading-xl">
            {s.quote.lead} <em>{s.quote.emphasis}</em> {s.quote.tail}
          </p>
        </blockquote>

        <dl class="parameters-row">
          {s.parameters.map((parameter) => (
            <div class="parameter reveal">
              <dt class="type-caption">{parameter.label}</dt>
              <dd>
                <span class="parameter-figure">{parameter.figure}</span>
                <span class="parameter-note type-body-regular">{parameter.note}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="studio-leadership site-section" id="leadership">
      <div class="section-inner">
        <SectionHeader tag="04 / Studio leadership" />
        <div class="team-list">
          {s.team.map((member) => (
            <details class="team-row" name="team">
              <summary>
                <span class="type-caption team-ref">{member.ref}</span>
                <img
                  class="team-thumb"
                  src={member.portrait}
                  alt={member.alt}
                  loading="lazy"
                  decoding="async"
                  width="56"
                  height="70"
                />
                <span class="team-name">{member.name}</span>
                <span class="team-role type-body-small">{member.role}</span>
                <span class="type-caption team-atelier">{member.atelier}</span>
                <span class="team-marker" aria-hidden="true"></span>
              </summary>

              <div class="team-panel">
                <div class="team-detail">
                  <p class="team-bio type-body-regular">{member.bio}</p>
                  <dl class="team-meta type-caption">
                    <div>
                      <dt>Education</dt>
                      <dd>{member.education}</dd>
                    </div>
                    <div>
                      <dt>Focus</dt>
                      <dd>{member.focus}</dd>
                    </div>
                  </dl>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens/variables' as *;

  $content-max: 1400px;
  $team-cols: 2.5rem 56px minmax(0, 6fr) minmax(0, 7fr) minmax(0, 3fr) 1.25rem;
  $team-gap: clamp(0.85rem, 2vw, 1.75rem);

  .studio {
    background-color: $color-bg;
    color: $color-text;
    overflow-x: hidden;
  }

  .section-inner {
    max-width: $content-max;
    margin-inline: auto;
  }

  .studio-intro {
    padding-top: clamp(7rem, 12vw, 11rem);
    padding-bottom: $space-section-y-sm;
    padding-inline: $space-fluid-page;

    .intro-copy {
      max-width: $content-max;
      margin-inline: auto;
      margin-bottom: clamp(3rem, 7vw, 5.5rem);
    }

    .intro-eyebrow {
      display: block;
      color: $color-muted;
      margin-bottom: clamp(2.5rem, 6vw, 5rem);
    }

    .intro-headline {
      line-height: 1.06;
      margin-bottom: clamp(1.5rem, 3vw, 2.25rem);

      span { display: block; }
    }

    .intro-lead {
      color: $color-muted;
      max-width: 52ch;
      line-height: 1.6;
      margin-bottom: clamp(2rem, 4vw, 3rem);
    }

    .intro-meta {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(1.5rem, 4vw, 3.5rem);

      dt {
        color: $color-muted;
        margin-bottom: 0.45rem;
      }

      dd {
        margin: 0;
        font-variant-numeric: tabular-nums;
      }
    }

    .intro-figure {
      width: 100vw;
      margin-left: 50%;
      transform: translateX(-50%);
      aspect-ratio: 21 / 9;
      overflow: hidden;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }

  .studio-philosophy {
    .pillar-grid {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(1.5rem, 3vw, 2.75rem);
    }

    .pillar-ref {
      display: block;
      color: $color-muted;
      margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
    }

    .pillar-title {
      font-size: $font-heading-l;
      font-weight: 400;
      line-height: 1.06;
      letter-spacing: -0.035em;
      margin-bottom: 0.9rem;

      span { display: block; }
    }

    .pillar-body {
      color: $color-muted;
      line-height: 1.6;
    }
  }

  .studio-parameters {
    .parameters-quote {
      max-width: 1100px;
      margin: 0 0 clamp(3rem, 6vw, 5rem) auto;

      p {
        line-height: 1.15;
        text-wrap: balance;
      }

      em {
        font-style: italic;
        font-family: $font-lora;
      }
    }

    .parameters-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-top: 1px solid $color-border;
    }

    .parameter {
      padding: clamp(1.25rem, 2vw, 1.75rem) clamp(1.5rem, 2.5vw, 2.25rem);

      &:first-child { padding-left: 0; }

      & + .parameter { border-left: 1px solid $color-border; }

      dt {
        color: $color-muted;
        margin-bottom: 0.9rem;
      }

      dd {
        margin: 0;
      }
    }

    .parameter-figure {
      display: block;
      font-size: clamp(1.75rem, 2.8vw, 2.375rem);
      line-height: 1;
      letter-spacing: -0.04em;
      font-variant-numeric: tabular-nums;
      margin-bottom: 0.7rem;
    }

    .parameter-note {
      display: block;
      color: $color-muted;
      line-height: 1.5;
    }
  }

  .studio-leadership {
    .team-row + .team-row {
      border-top: 1px solid $color-border;
    }

    summary {
      list-style: none;
      cursor: pointer;
      display: grid;
      grid-template-columns: $team-cols;
      align-items: center;
      gap: $team-gap;
      padding-block: clamp(0.85rem, 1.6vw, 1.15rem);
      transition: opacity 0.3s $ease-editorial;

      &::-webkit-details-marker { display: none; }

      &:hover { opacity: 0.62; }

      &:focus-visible {
        outline: 1px solid $color-text;
        outline-offset: 4px;
      }
    }

    .team-thumb {
      width: 56px;
      height: 70px;
      object-fit: cover;
      object-position: center 20%;
      filter: grayscale(1) contrast(1.05);
    }

    .team-ref,
    .team-atelier,
    .team-role {
      color: $color-muted;
    }

    .team-name {
      font-size: clamp(1.05rem, 1.6vw, 1.4rem);
      line-height: 1.2;
      letter-spacing: -0.025em;
    }

    .team-marker {
      justify-self: end;
      position: relative;
      width: 11px;
      height: 11px;

      &::before,
      &::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        width: 11px;
        height: 1px;
        background-color: $color-text;
        transition: transform 0.4s $ease-editorial;
      }

      &::after { transform: rotate(90deg); }
    }

    .team-row[open] .team-marker::after {
      transform: rotate(0deg);
    }

    .team-panel {
      display: grid;
      grid-template-columns: $team-cols;
      gap: $team-gap;
      padding-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
    }

    .team-detail {
      grid-column: 3 / 4;
    }

    .team-bio {
      color: $color-muted;
      line-height: 1.65;
      margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
    }

    .team-meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1.25rem, 2.5vw, 2rem);

      dt {
        color: $color-muted;
        margin-bottom: 0.4rem;
      }

      dd { margin: 0; }
    }
  }

  @media (max-width: 1024px) {
    .studio-parameters {
      .parameters-row { grid-template-columns: 1fr; }

      .parameter { padding-inline: 0; }

      .parameter + .parameter {
        border-left: none;
        border-top: 1px solid $color-border;
      }
    }
  }

  @media (max-width: 700px) {
    .studio-intro .intro-figure { aspect-ratio: 16 / 10; }

    .studio-philosophy .pillar-grid {
      grid-template-columns: 1fr;
      gap: clamp(2.25rem, 5vw, 3rem);
    }

    .studio-leadership {
      summary {
        grid-template-columns: 56px 1fr 1.25rem;
        row-gap: 0.3rem;
        align-items: start;

        .team-ref { display: none; }
        .team-thumb { grid-row: 1 / span 3; }
        .team-name,
        .team-role,
        .team-atelier { grid-column: 2; }
        .team-marker { grid-column: 3; grid-row: 1; }
      }

      .team-panel {
        grid-template-columns: 1fr;
      }

      .team-detail { grid-column: 1; }

      .team-meta { grid-template-columns: 1fr; gap: 1rem; }
    }
  }
</style>